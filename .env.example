WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
SYNC_ENVIRONMENT=staging
DRY_RUN=true
DEFAULT_PRODUCT_STATUS=draft
ALLOW_DELETE=false
GOOGLE_SERVICE_ACCOUNT_FILE=
CLM_SPREADSHEET_ID=
CLM_DRIVE_FOLDER_ID=
MD_DRIVE_FOLDER_ID=
# Shared setting: this example uses the legacy google-doctor/supplier-inventory scope.
# build-drive-folder-manifests requires instead: https://www.googleapis.com/auth/drive.metadata.readonly
# Sheets-only inspect-sheet-layout/discover-mapped-media-sources ignore Drive scope and folder IDs.
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.readonly
GOOGLE_SHEETS_SCOPE=https://www.googleapis.com/auth/spreadsheets.readonly
GOOGLE_PROXY_MODE=
GOOGLE_PROXY_HOST=
GOOGLE_PROXY_PORT=
GOOGLE_PROXY_RDNS=true
